# demo_app — environment variable documentation
# Copy this file to demo_app/.env and fill in values for local development.
# Never commit .env to version control.

# PostgreSQL connection string expected by the demo application.
# The application reads this variable to determine database availability.
# The value below is a placeholder — the app does NOT open a real connection for the demo.
DATABASE_URL=postgresql://demo:demo@localhost:5432/ripple
