# Ripple MCP — environment variable documentation
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# URL of the demo application's health endpoint.
# check_service_health will call this endpoint.
# Default (used when variable is unset): http://127.0.0.1:8000/health
RIPPLE_HEALTH_URL=http://127.0.0.1:8000/health

# The .bob/mcp.json config injects PYTHONPATH and the .venv/bin PATH so Bob
# picks up the virtualenv packages automatically.
# If you need a different interpreter, update "command" in .bob/mcp.json.
# Example: "command": "/absolute/path/to/.venv/bin/python3"

# --- CI live status (optional) ---
# GitHub repository slug for live CI status fetching.
# If unset, get_ci_status() auto-detects from the git remote.
# RIPPLE_GITHUB_REPO=Mechantchulo/Ripple-MCP

# GitHub Personal Access Token for CI status fetching.
# Required for private repos; optional but recommended for higher rate limits.
# Never commit this value.
# RIPPLE_GITHUB_TOKEN=ghp_...

# Branch to query for the latest CI run (default: erick).
# RIPPLE_GITHUB_BRANCH=erick
