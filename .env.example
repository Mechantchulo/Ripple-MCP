# Ripple MCP — environment variable documentation
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# URL of the demo application's health endpoint.
# check_service_health will call this endpoint.
# Default (used when variable is unset): http://localhost:8000/health
RIPPLE_HEALTH_URL=http://localhost:8000/health

# --- GitHub integration (CI status + Pull Requests) ---
# GitHub repository slug used by get_ci_status, create_pull_request, and
# get_pull_request_status. Auto-detected from the git remote when unset.
# RIPPLE_GITHUB_REPO=owner/repo

# GitHub Personal Access Token.
# - For get_ci_status: optional, but recommended for higher rate limits and private repos.
# - For create_pull_request: required (needs repository pull-request write access).
# Prefer `ripple auth github`; use this variable for CI or temporary overrides.
# Never commit a real token.
# RIPPLE_GITHUB_TOKEN=

# Branch to query for the latest CI run (defaults to the current branch, then main).
# RIPPLE_GITHUB_BRANCH=main
